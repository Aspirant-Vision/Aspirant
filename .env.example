# ==============================================================================
# ASPIRANT VISION — PRODUCTION ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================
# Security Notice:
# - NEVER commit sensitive credentials, tokens, or service-role keys to Git.
# - Copy this file to .env.local for local development.
# - For Vercel / Production deployment, configure these in the project dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Node runtime environment ('development' | 'test' | 'production')
NODE_ENV=production

# Canonical public site URL (Used for auth redirects, email verification & sitemap)
# Local: http://localhost:3000
# Production: https://aspirantvision.com
NEXT_PUBLIC_SITE_URL=https://aspirantvision.com

# ------------------------------------------------------------------------------
# 2. SUPABASE PUBLIC CLIENT CONFIGURATION (Browser Safe)
# ------------------------------------------------------------------------------
# Supabase Project REST/Auth URL
# Format: https://<project-id>.supabase.co or http://127.0.0.1:54321 for local CLI
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public API Key (Anon / Publishable)
# Safe to expose in the browser. Governed by PostgreSQL Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 3. SUPABASE SERVER / PRIVILEGED CREDENTIALS (Strictly Server-Only)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS for admin tasks like staff invites)
# WARNING: NEVER prefix with NEXT_PUBLIC_. NEVER import or expose in client components.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Database Connection String
# Used by migrations, CLI, and direct connection pools (Session / Transaction pooler)
# Format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 4. SANITY CMS CONFIGURATION (Optional / Phase 11 Editorial Blog)
# ------------------------------------------------------------------------------
# Public Project ID and Dataset for headless content delivery
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Server-only read/write token for draft previews and ISR revalidation webhooks
# SANITY_API_READ_TOKEN=your-sanity-read-token
# SANITY_REVALIDATE_SECRET=your-webhook-secret-token

# ------------------------------------------------------------------------------
# 5. STORAGE & SECURITY POLICIES
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (10MB = 10485760)
NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES=10485760

# Allowed MIME types for student application document uploads:
# application/pdf, image/jpeg, image/png, image/webp
